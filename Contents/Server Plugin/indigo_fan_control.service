[Unit]
Description=Indigo UniFi Plugin - UNAS Fan Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/indigo_fan_control.sh --service
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
