		</ConfigUI>
	</Action>

	<Action id="setCameraIRMode" deviceFilter="self.protectCamera">
		<Name>Set IR Mode</Name>
		<CallbackMethod>actionSetIRMode</CallbackMethod>
		<ConfigUI>
			<Field id="irMode" type="menu" defaultValue="auto">
				<Label>IR Mode:</Label>
				<List>
					<Option value="auto">Auto</Option>
					<Option value="on">Always On</Option>
					<Option value="off">Always Off</Option>
					<Option value="autoFilterOnly">Auto (Filter Only)</Option>
				</List>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="setCameraStatusLight" deviceFilter="self.protectCamera">
		<Name>Set Status Light</Name>
		<CallbackMethod>actionSetStatusLight</CallbackMethod>
		<ConfigUI>
			<Field id="enabled" type="checkbox" defaultValue="true">
				<Label>Enable Status Light:</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="setCameraOverlays" deviceFilter="self.protectCamera">
		<Name>Set Overlay Settings</Name>
		<CallbackMethod>actionSetOverlays</CallbackMethod>
		<ConfigUI>
			<Field id="showName" type="checkbox" defaultValue="true">
				<Label>Show Name:</Label>
			</Field>
			<Field id="showDate" type="checkbox" defaultValue="true">
				<Label>Show Date:</Label>
			</Field>
			<Field id="showLogo" type="checkbox" defaultValue="false">
				<Label>Show Logo:</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="setCameraStatusMessage" deviceFilter="self.protectCamera">
		<Name>Set Status Message</Name>
		<CallbackMethod>actionSetStatusMessage</CallbackMethod>
		<ConfigUI>
			<Field id="message" type="textfield">
				<Label>Status Message:</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="enableCameraDetections" deviceFilter="self.protectCamera">
		<Name>Set Smart Detection Types</Name>
		<CallbackMethod>actionEnableDetections</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Motion detection itself is always on - these are UniFi's AI-based object detection types layered on top. Only cameras with AI detection hardware support this; check the camera's feature flags if unsure. This REPLACES the camera's current object-type selection with exactly what's checked below.</Label>
			</Field>
			<Field id="detectPerson" type="checkbox" defaultValue="true">
				<Label>Person:</Label>
			</Field>
			<Field id="detectVehicle" type="checkbox" defaultValue="true">
				<Label>Vehicle:</Label>
			</Field>
			<Field id="detectPackage" type="checkbox" defaultValue="true">
				<Label>Package:</Label>
			</Field>
			<Field id="detectAnimal" type="checkbox" defaultValue="false">
				<Label>Animal:</Label>
			</Field>
			<Field id="detectFace" type="checkbox" defaultValue="false">
				<Label>Face:</Label>
			</Field>
			<Field id="detectLicensePlate" type="checkbox" defaultValue="false">
				<Label>License Plate:</Label>
			</Field>
			<Field id="sep1" type="separator"/>
			<Field id="audioHelpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Audio detection (3.12.8) - listens via the camera's own microphone, requires a camera with one (hasMic). Also REPLACES the current audio-type selection with exactly what's checked below.</Label>
			</Field>
			<Field id="detectSmokeAlarm" type="checkbox" defaultValue="true">
				<Label>Smoke Alarm Sound:</Label>
			</Field>
			<Field id="detectCoAlarm" type="checkbox" defaultValue="true">
				<Label>CO Alarm Sound:</Label>
			</Field>
			<Field id="detectBurglarAlarm" type="checkbox" defaultValue="true">
				<Label>Burglar Alarm Sound:</Label>
			</Field>
			<Field id="detectGlassBreak" type="checkbox" defaultValue="true">
				<Label>Glass Break:</Label>
			</Field>
			<Field id="detectSiren" type="checkbox" defaultValue="true">
				<Label>Siren:</Label>
			</Field>
			<Field id="detectBabyCry" type="checkbox" defaultValue="false">
				<Label>Baby Crying:</Label>
			</Field>
			<Field id="detectSpeech" type="checkbox" defaultValue="false">
				<Label>Speech:</Label>
			</Field>
			<Field id="detectBark" type="checkbox" defaultValue="false">
				<Label>Bark:</Label>
			</Field>
			<Field id="detectCarHorn" type="checkbox" defaultValue="false">
				<Label>Car Horn:</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="setCameraHDRMode" deviceFilter="self.protectCamera">
		<Name>Set HDR Mode</Name>
		<CallbackMethod>actionSetHDRMode</CallbackMethod>
		<ConfigUI>
			<Field id="hdrMode" type="menu" defaultValue="auto">
				<Label>HDR Mode:</Label>
				<List>
					<Option value="auto">Auto</Option>
					<Option value="on">On</Option>
					<Option value="off">Off</Option>
				</List>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="setCameraMicVolume" deviceFilter="self.protectCamera">
		<Name>Set Microphone Volume</Name>
		<CallbackMethod>actionSetMicVolume</CallbackMethod>
		<ConfigUI>
			<Field id="volume" type="textfield" defaultValue="100">
				<Label>Volume (0-100):</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="setCameraVideoMode" deviceFilter="self.protectCamera">
		<Name>Set Video Mode</Name>
		<CallbackMethod>actionSetVideoMode</CallbackMethod>
		<ConfigUI>
			<Field id="videoMode" type="menu" defaultValue="default">
				<Label>Video Mode:</Label>
				<List class="self" method="getVideoModeList" dynamicReload="true"/>
			</Field>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Only modes this camera itself reports supporting are listed. If this camera hasn't been read yet, every mode from Protect's published spec is shown instead, marked (unverified) - picking one is still checked against the real camera when sent.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="rebootCamera" deviceFilter="self.protectCamera">
		<Name>Reboot Camera</Name>
		<CallbackMethod>actionRebootCamera</CallbackMethod>
	</Action>

	<Action id="takeSnapshot" deviceFilter="self.protectCamera">
		<Name>Take Snapshot</Name>
		<CallbackMethod>actionTakeSnapshot</CallbackMethod>
		<ConfigUI>
			<Field id="savePath" type="textfield">
				<Label>Save Path (optional):</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="enableRtspStreaming" deviceFilter="self.protectCamera">
		<Name>Enable RTSP Streaming</Name>
		<CallbackMethod>actionEnableRtspStreaming</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>RTSP(S) stream URLs are not exposed automatically - the official Protect API treats them as an opt-in resource you must explicitly request per quality level. Running this fills in the camera's RTSP URL states for the qualities checked below. Safe to run again later: already-active qualities are left alone rather than recreated.</Label>
			</Field>
			<Field id="enableHigh" type="checkbox" defaultValue="true">
				<Label>High quality:</Label>
			</Field>
			<Field id="enableMedium" type="checkbox" defaultValue="true">
				<Label>Medium quality:</Label>
			</Field>
			<Field id="enableLow" type="checkbox" defaultValue="true">
				<Label>Low quality:</Label>
			</Field>
			<Field id="enablePackage" type="checkbox" defaultValue="false">
				<Label>Package camera quality:</Label>
				<Description>Only applicable to cameras with a dedicated package-detection sensor (e.g. G4 Doorbell Pro).</Description>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="disableRtspStreaming" deviceFilter="self.protectCamera">
		<Name>Disable RTSP Streaming</Name>
		<CallbackMethod>actionDisableRtspStreaming</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Removes all currently active RTSP streams for this camera and clears its RTSP URL states.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="dumpCameraPayload" deviceFilter="self.protectCamera">
		<Name>Run Camera Payload Diagnostic</Name>
		<CallbackMethod>actionDumpCameraPayload</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Fetches this camera both via the bulk camera list and a fresh single-camera request, logs both in full, and reports any difference in which fields each one includes. Use this to diagnose states that show blank/Unknown - it doesn't require debug logging to be enabled.</Label>
			</Field>
		</ConfigUI>
	</Action>

