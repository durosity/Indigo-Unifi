	<Action id="setFanMode" deviceFilter="self.driveFan">
		<Name>Set UNAS Fan Mode</Name>
		<CallbackMethod>actionSetFanMode</CallbackMethod>
		<ConfigUI>
			<Field id="fanMode" type="menu" defaultValue="Balance">
				<Label>Fan Mode:</Label>
				<List>
					<Option value="Quiet">Quiet</Option>
					<Option value="Balance">Balance</Option>
					<Option value="Cooling">Cooling</Option>
				</List>
			</Field>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Quiet runs the fan as slow as possible (lower acoustic noise, higher temperature). Cooling prioritises temperature (more noise). Balance is the default.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="wakeUNAS" deviceFilter="self.unifiDriveController">
		<Name>Wake UNAS (Wake-on-LAN)</Name>
		<CallbackMethod>actionWakeUNAS</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Sends a Wake-on-LAN magic packet to the UNAS. The UNAS device must be on the same broadcast domain and have Wake-on-LAN enabled in BIOS/firmware. Uses the MAC address from the UNAS system info (if available).</Label>
			</Field>
		</ConfigUI>
	</Action>
</Actions>
