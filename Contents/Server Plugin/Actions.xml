<?xml version="1.0"?>
<Actions>
	<!-- MENU ACTIONS (No device filter - work on controller selection) -->
	<Action id="menuDiscoverCameras">
		<Name>Discover Camera Devices</Name>
		<CallbackMethod>menuDiscoverCameras</CallbackMethod>
		<ConfigUI>
			<Field id="controllerId" type="menu">
				<Label>UniFi Controller:</Label>
				<List class="self" filter="" method="getControllerList"/>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="triggerAlarmWebhook">
		<Name>Trigger Alarm Manager Webhook</Name>
		<CallbackMethod>actionTriggerAlarmWebhook</CallbackMethod>
		<ConfigUI>
			<Field id="controllerId" type="menu">
				<Label>UniFi Controller:</Label>
				<List class="self" filter="" method="getControllerList"/>
			</Field>
			<Field id="triggerId" type="textfield">
				<Label>Trigger ID:</Label>
			</Field>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Fires any Protect Alarm Manager alarm configured with a matching Webhook trigger (Alarm Manager > your alarm > Webhook trigger - enter the ID exactly as set up there). This is the official, documented API - separate from the experimental Alarm Profile arm/disarm elsewhere in this plugin, and doesn't arm or disarm anything itself; it only fires whatever action you've already configured for this trigger ID. Supports Indigo variable substitution (%%v:12345%%) if you'd rather not hardcode the ID.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="menuDiscoverNetworkDevices">
		<Name>Discover Network Devices</Name>
		<CallbackMethod>menuDiscoverNetworkDevices</CallbackMethod>
		<ConfigUI>
			<Field id="controllerId" type="menu">
				<Label>UniFi Controller:</Label>
				<List class="self" filter="" method="getControllerList"/>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="menuDiscoverFirewallPolicies">
		<Name>Discover Firewall Policies</Name>
		<CallbackMethod>menuDiscoverFirewallPolicies</CallbackMethod>
		<ConfigUI>
			<Field id="controllerId" type="menu">
				<Label>UniFi Controller:</Label>
				<List class="self" filter="" method="getControllerList"/>
			</Field>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Creates a device for every custom (non-predefined) firewall policy. Safe to re-run - existing devices are skipped, not duplicated.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="menuDiscoverTrafficRoutes">
		<Name>Discover Traffic Routes</Name>
		<CallbackMethod>menuDiscoverTrafficRoutes</CallbackMethod>
		<ConfigUI>
			<Field id="controllerId" type="menu">
				<Label>UniFi Controller:</Label>
				<List class="self" filter="" method="getControllerList"/>
			</Field>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Creates a device for every traffic route. Safe to re-run - existing devices are skipped, not duplicated.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="menuDiscoverPortForwards">
		<Name>Discover Port Forwards</Name>
		<CallbackMethod>menuDiscoverPortForwards</CallbackMethod>
		<ConfigUI>
			<Field id="controllerId" type="menu">
				<Label>UniFi Controller:</Label>
				<List class="self" filter="" method="getControllerList"/>
			</Field>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Creates a device for every port forward rule. Safe to re-run - existing devices are skipped, not duplicated.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="menuDiscoverWLANs">
		<Name>Discover WLANs</Name>
		<CallbackMethod>menuDiscoverWLANs</CallbackMethod>
		<ConfigUI>
			<Field id="controllerId" type="menu">
				<Label>UniFi Controller:</Label>
				<List class="self" filter="" method="getControllerList"/>
			</Field>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Creates a device for every WLAN/SSID. Safe to re-run - existing devices are skipped, not duplicated.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="menuDiscoverAlarmProfiles">
		<Name>Discover Alarm Profiles (Experimental)</Name>
		<CallbackMethod>menuDiscoverAlarmProfiles</CallbackMethod>
		<ConfigUI>
			<Field id="controllerId" type="menu">
				<Label>UniFi Controller:</Label>
				<List class="self" filter="" method="getControllerList"/>
			</Field>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Creates a device for every Alarm Manager arm profile found. EXPERIMENTAL - if nothing is created, this likely means the profile data isn't where this plugin currently looks for it. Create one Alarm Profile device manually instead and use its "Dump Device Payload to Log" button, then send the result to Durosity.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<!-- CONTROLLER ACTIONS -->
	<Action id="restartController" deviceFilter="self.unifiController">
		<Name>Restart Controller</Name>
		<CallbackMethod>actionRestartController</CallbackMethod>
	</Action>

	<Action id="discoverAllClients" deviceFilter="self.unifiController">
		<Name>Create All Clients</Name>
		<CallbackMethod>actionDiscoverAllClients</CallbackMethod>
		<ConfigUI>
			<Field id="minLastSeen" type="menu" defaultValue="30">
				<Label>Only include clients seen within:</Label>
				<List>
					<Option value="0">Any time (all clients)</Option>
					<Option value="1">Last 24 hours</Option>
					<Option value="7">Last 7 days</Option>
					<Option value="30">Last 30 days</Option>
					<Option value="90">Last 90 days</Option>
				</List>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="discoverUnknownClients" deviceFilter="self.unifiController">
		<Name>Create Unknown Clients</Name>
		<CallbackMethod>actionDiscoverUnknownClients</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Creates devices for unknown clients (guests) that haven't been auto-created. Will not recreate previously deleted clients.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="removeMissingClients" deviceFilter="self.unifiController">
		<Name>Remove Missing Clients</Name>
		<CallbackMethod>actionRemoveMissingClients</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Removes client devices that no longer exist on the UniFi controller. Use this to clean up old/stale devices.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="purgeRandomisedClients" deviceFilter="self.unifiController">
		<Name>Purge Randomised Clients</Name>
		<CallbackMethod>actionPurgeRandomisedClients</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Removes clients with randomised (locally-administered) MAC addresses that haven't been seen recently. Both the Indigo device AND the UniFi controller's client record are removed.&#10;&#10;Behaviour is controlled by the per-controller settings (purge after X hours, skip-if-named, skip-if-fixed-IP, skip-if-Indigo-device-exists, dry-run). To preview without changes, tick "Dry run" on the controller config first.&#10;&#10;Use Indigo's schedule/trigger system to run this periodically (e.g. once a day).</Label>
			</Field>
		</ConfigUI>
	</Action>

	<!-- CAMERA ACTIONS -->
