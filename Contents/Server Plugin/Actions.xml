	<!-- ACCESS DOOR ACTIONS -->
	<Action id="unlockDoor" deviceFilter="self.accessDoor">
		<Name>Unlock Door (Momentary)</Name>
		<CallbackMethod>actionUnlockDoor</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Unlocks the door, then auto-relocks: within ~10s if never opened, or once closed again if it is. Available regardless of the device's own Unlock-button setting.</Label>
			</Field>
		</ConfigUI>
	</Action>

	<Action id="unlockDoorLeaveUnlocked" deviceFilter="self.accessDoor">
		<Name>Unlock Door (Leave Unlocked)</Name>
		<CallbackMethod>actionUnlockDoorLeaveUnlocked</CallbackMethod>
		<ConfigUI>
			<Field id="helpText" type="label" fontSize="small" fontColor="darkgray">
				<Label>Unlocks the door and leaves it unlocked indefinitely - no auto-relock. Use "Lock Door" (or the device's Lock button) to re-lock. Available regardless of the device's own Unlock-button setting.</Label>
